tabItem(tabName = "anova",
fluidPage(
h2("Analyse ANOVA"),
div(style = "background-color: #f8f9fa; padding: 20px; border-radius: 10px;",
strong("Dans cette application, vous pouvez charger vos données et exécuter une ANOVA pour explorer les relations entre les variables.")
),
fileInput("file_anova", "Choisir un fichier CSV", accept = ".csv"),
radioButtons("anova_type", "Type d'ANOVA",
choices = list("ANOVA à un facteur" = "anova1", "ANOVA à deux facteurs" = "anova2"),
inline = TRUE),
uiOutput("var_select"),
actionButton("run_anova", "Exécuter l'ANOVA", icon = icon("play")),
box(title = "Résultats de l'ANOVA", width = 12, solidHeader = TRUE, status = "primary",
uiOutput("anova_result")),
box(title = "Graphique ANOVA", width = 12, solidHeader = TRUE, status = "info",
plotlyOutput("anova_plot")),  # Use plotly for interactive plots
box(title = "Télécharger les résultats", width = 12, solidHeader = TRUE, status = "success",
downloadButton("download_anova", "Télécharger les résultats"))  # Add download button
)
)
# Enhanced ANOVA Server Logic
observeEvent(input$run_anova, {
output$anova_result <- renderUI({
req(input$file_anova, input$dependent_var, input$factor1)
df <- read.csv(input$file_anova$datapath, sep = ";")
df[[input$factor1]] <- as.factor(df[[input$factor1]])
data <- df %>% select(all_of(c(input$dependent_var, input$factor1)))
colnames(data) <- c("score", "group")
data$group <- as.factor(data$group)
output_content <- list()
output_content[[1]] <- tags$h3(" Niveaux du facteur:")
output_content[[2]] <- tags$p(paste("Facteur:", paste(levels(data$group), collapse = ", ")))
output_content[[3]] <- tags$h3(" Statistiques descriptives:")
output_content[[4]] <- renderPrint({data %>% group_by(group) %>% get_summary_stats(score, type = "mean_sd")})
output_content[[5]] <- tags$h3(" Test de normalité:")
output_content[[6]] <- renderPrint({data %>% group_by(group) %>% shapiro_test(score)})
output_content[[7]] <- tags$h3(" Test d'homogénéité des variances:")
output_content[[8]] <- renderPrint({
bartlett_res <- bartlett.test(data$score ~ data$group)
list("Bartlett Test" = bartlett_res, "Levene Test" = data %>% levene_test(score ~ group))
})
output_content[[9]] <- tags$h3(" Résultat de l'ANOVA:")
output_content[[10]] <- renderPrint({summary(aov(score ~ group, data = data))})
output_content[[11]] <- tags$h3(" Test post-hoc de Tukey:")
output_content[[12]] <- renderPrint({data %>% tukey_hsd(score ~ group)})
output_content[[13]] <- tags$h3(" Normalité des résidus:")
output_content[[14]] <- renderPrint({
mdl <- lm(score ~ group, data = data)
shapiro_test(residuals(mdl))
})
if (shapiro_test(residuals(mdl))$p.value < 0.05) {
output_content[[15]] <- tags$p(tags$strong("Les résidus ne sont pas normaux. Utilisation de tests non paramétriques."))
output_content[[16]] <- renderPrint({data %>% kruskal_test(score ~ group)})
output_content[[17]] <- renderPrint({data %>% kruskal_effsize(score ~ group)})
output_content[[18]] <- tags$h3("8. Test post-hoc de Dunn:")
output_content[[19]] <- renderPrint({data %>% dunn_test(score ~ group, p.adjust.method = "bonferroni")})
}
if (bartlett.test(data$score ~ data$group)$p.value < 0.05) {
output_content[[20]] <- tags$p(tags$strong("Les variances ne sont pas homogènes. Utilisation de tests alternatifs."))
output_content[[21]] <- renderPrint({data %>% games_howell_test(score ~ group)})
}
return(output_content)
})
output$anova_plot <- renderPlotly({
req(input$file_anova, input$dependent_var, input$factor1)
df <- read.csv(input$file_anova$datapath, sep = ";")
df[[input$factor1]] <- as.factor(df[[input$factor1]])
data <- df %>% select(all_of(c(input$dependent_var, input$factor1)))
colnames(data) <- c("score", "group")
data$group <- as.factor(data$group)
p <- ggboxplot(data, x = "group", y = "score") +
stat_pvalue_manual(data %>% tukey_hsd(score ~ group) %>% add_xy_position(x = "group"), hide.ns = TRUE)
ggplotly(p)  # Convert ggplot to plotly for interactivity
})
output$download_anova <- downloadHandler(
filename = function() {
paste("anova_results_", Sys.Date(), ".csv", sep = "")
},
content = function(file) {
req(input$file_anova, input$dependent_var, input$factor1)
df <- read.csv(input$file_anova$datapath, sep = ";")
df[[input$factor1]] <- as.factor(df[[input$factor1]])
data <- df %>% select(all_of(c(input$dependent_var, input$factor1)))
colnames(data) <- c("score", "group")
data$group <- as.factor(data$group)
results <- data %>% group_by(group) %>% get_summary_stats(score, type = "mean_sd")
write.csv(results, file, row.names = FALSE)
}
)
})
